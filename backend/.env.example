# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/focusflow

# JWT Secret — change this to a long random string in production
JWT_SECRET=focusflow_ai_phase2_secret_key_2026

# Email Configuration (Gmail SMTP for OTP password reset)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password

# Frontend URL (used for CORS and password reset links)
FRONTEND_URL=http://localhost:3000

# Server port — must match NEXT_PUBLIC_API_URL in frontend .env.local
PORT=5005
NODE_ENV=development
