# Database Connection (Supabase PostgreSQL via connection pooler or direct URI)
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Server Port & Environment (must match NEXT_PUBLIC_API_URL in frontend)
PORT=5001
NODE_ENV=development

# JWT Secret — change this to a long random secret in production
JWT_SECRET=focusflow_ai_secret_key_change_in_production_2026

# Frontend & Application URLs (used for CORS and origin validation)
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Support & Contact Recipient Email
CONTACT_EMAIL=support@focusflow.dev

# Email Delivery Configuration (Choose Option A or Option B)
# Option A: Gmail / Custom SMTP (delivers to ALL users worldwide)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Option B: Resend (Requires verified custom domain for public delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=FocusFlow AI <notifications@yourdomain.com>
RESEND_OWNER_EMAIL=support@focusflow.dev

# Razorpay Subscriptions (₹399/mo Pro recurring plan)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_PRO_PLAN_ID=plan_your_pro_plan_id
# (Legacy alias RAZORPAY_PLAN_PRO is also supported)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_MODE=test

# Gemini AI Planner (server-side only; never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
