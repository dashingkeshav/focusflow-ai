{
  "manifest_version": 3,
  "name": "FocusFlow AI — Study Focus & Distraction Tracker",
  "version": "2.0.0",
  "description": "Monitors tab switching frequency, idle duration, and behavioral interaction rates to compute live Focus Scores.",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:5005/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:5005/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusFlow AI Dashboard"
  }
}
