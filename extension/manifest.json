{
  "manifest_version": 3,
  "name": "FocusFlow AI — Smart Focus & Distraction Protection",
  "version": "3.0.0",
  "description": "Task-aware focus protection: classifies sites as productive, possibly productive or distracting during Focus Sessions, with warnings instead of blanket blocking.",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "activeTab",
    "webNavigation",
    "scripting",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:5001/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:5001/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "FocusFlow AI — Smart Focus"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "overlay.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
